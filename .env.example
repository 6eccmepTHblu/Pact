# Скопировать в .env и заполнить. Пароли БД — только [A-Za-z0-9]:
#   python -c "import secrets; print(secrets.token_hex(24))"

# Владелец БД: под ним идут миграции. Приложение его не знает.
POSTGRES_PASSWORD=
# Роль приложения: без UPDATE/DELETE на журнал и подписи.
APP_DB_PASSWORD=
# Подпись cookie сессии.
SECRET_KEY=

HUSBAND_LOGIN=
HUSBAND_NAME=Супруг
HUSBAND_PASSWORD=
WIFE_LOGIN=
WIFE_NAME=Супруга
WIFE_PASSWORD=

# Порт на 127.0.0.1, на него смотрит Caddy.
APP_PORT=8200
# Порт БД на 127.0.0.1 для тестов и отладки.
DB_PORT=5433
# Локально по http — false.
COOKIE_SECURE=true

# LLM. Без ключа Пакт работает, разметка — вручную.
# Ollama: OPENAI_BASE_URL=http://host.docker.internal:11434/v1, ключ любой непустой.
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4.1-mini
EMBED_MODEL=text-embedding-3-small

# Web Push: сгенерировать docker compose run --rm app python -m app.cli vapid-keys
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:pact@example.com
# Секрет в адресе ICS-фида /calendar/<token>.ics; пусто — фид выключен.
CALENDAR_TOKEN=
